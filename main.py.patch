+@app.route('/demo/processar', methods=['POST'])
+def demo_processar():
+    """Recebe lead + respostas, calcula com o motor oficial, grava o lead
+    no bucket 'leads' e devolve a devolutiva. Uma única transação garante
+    que o lead fique sempre ligado às respostas e ao resultado."""
+    f = request.form
+
+    # 1) Consentimento LGPD obrigatório para processar
+    if f.get('aceite_lgpd') not in ('on', 'true', '1', 'sim'):
+        return render_template_string(
+            T_DEMO, logo=LOGO, perguntas=DEMO_PERGUNTAS,
+            erro='É necessário concordar com o tratamento dos dados para ver o resultado.')
+
+    # 2) Dados do lead (5 campos)
+    lead_nome = (f.get('nome') or '').strip()
+    lead_email = (f.get('email') or '').strip()
+    lead_tel = (f.get('telefone') or '').strip()
+    lead_colab = (f.get('num_colaboradores') or '').strip()
+    lead_cargo = (f.get('cargo') or '').strip()
+    if not (lead_nome and lead_email):
+        return render_template_string(
+            T_DEMO, logo=LOGO, perguntas=DEMO_PERGUNTAS,
+            erro='Informe ao menos nome e e-mail para continuar.')
+
+    # 3) Respostas -> dict no formato do motor oficial (só campos que pontuam)
+    respostas_motor = {}
+    respostas_demo = {}   # registro completo (inclui Q7 transversal)
+    q7_nivel = None
+    for i, p in enumerate(DEMO_PERGUNTAS):
+        val = f.get(f'q{i}')
+        try:
+            val_int = int(val)
+        except (TypeError, ValueError):
+            val_int = None
+        respostas_demo[f'q{i}'] = {'titulo': p['titulo'], 'valor': val_int}
+        if p['campo'] and val_int and 1 <= val_int <= 5:
+            respostas_motor[p['campo']] = val_int
+        if p['campo'] is None and val_int:
+            q7_nivel = val_int
+
+    # 4) CÁLCULO OFICIAL — motor intacto
+    resultado = calcular(respostas_motor)
+
+    # 5) View filtrada para o lead/devolutiva (sem pesos/detalhes/campos internos)
+    res_publico = {
+        'nota_geral': resultado['nota_geral'],
+        'estagio': resultado['estagio'],
+        'dispersao': resultado['dispersao'],
+        'dispersao_nivel': resultado['dispersao_nivel'],
+        'pilares': {k: v for k, v in resultado['pilares'].items()},
+        'nomes_pilares': resultado['nomes_pilares'],
+    }
+
+    # 6) Gravar o lead no bucket 'leads' (mesmo dnamap.db), ligado às respostas e ao resultado
+    lead_id = 'lead_' + str(uuid.uuid4())[:8]
+    DB.setdefault('leads', {})[lead_id] = {
+        'id': lead_id,
+        'nome': lead_nome,
+        'email': lead_email,
+        'telefone': lead_tel,
+        'num_colaboradores': lead_colab,
+        'cargo': lead_cargo,
+        'aceite_lgpd': True,
+        'aceite_comercial': f.get('aceite_comercial') in ('on', 'true', '1', 'sim'),
+        'origem': 'Experiência Demonstrativa DNA Map',
+        'criado_em': datetime.now().isoformat(),
+        'respostas_demo': respostas_demo,
+        'resultado_demo': res_publico,
+        'q7_dependencia_dono': q7_nivel,
+    }
+    try:
+        persist()
+    except Exception as e:
+        app.logger.error(f'demo lead persist error: {e}')
+
+    devolutiva = _demo_devolutiva(resultado, q7_nivel)
+    return render_template_string(
+        T_DEMO_RESULTADO, logo=LOGO, res=res_publico, nome=lead_nome,
+        devolutiva=devolutiva, q7_nivel=q7_nivel, perguntas=DEMO_PERGUNTAS)
+
