+def _demo_devolutiva(res, q7_nivel):
+    """Gera texto de devolutiva a partir do resultado oficial.
+    Não inventa números: usa apenas o que o motor retornou."""
+    pilares = {k: v for k, v in res['pilares'].items() if v is not None}
+    nomes = res['nomes_pilares']
+    linhas = []
+    if pilares:
+        forte = max(pilares, key=pilares.get)
+        fraco = min(pilares, key=pilares.get)
+        linhas.append(f"Seu ponto mais forte nesta prévia é <b>{nomes.get(forte, forte)}</b> "
+                      f"(nota {pilares[forte]:.1f}).")
+        if fraco != forte:
+            linhas.append(f"A maior oportunidade de evolução está em <b>{nomes.get(fraco, fraco)}</b> "
+                          f"(nota {pilares[fraco]:.1f}).")
+    disp = res.get('dispersao_nivel')
+    if disp == 'Saudável':
+        linhas.append("A maturidade está <b>equilibrada</b> entre os pilares avaliados — crescimento sustentável.")
+    elif disp == 'Alerta':
+        linhas.append("Há <b>desequilíbrio em alerta</b> entre os pilares: alguns avançam enquanto outros ficam para trás.")
+    elif disp == 'Crítico':
+        linhas.append("Há <b>desequilíbrio crítico</b> entre os pilares — risco de gargalo que trava o crescimento.")
+    # Q7 — leitura qualitativa, separada do cálculo
+    if q7_nivel:
+        if q7_nivel <= 2:
+            linhas.append("Sobre <b>dependência do dono</b>: a empresa ainda depende fortemente da presença do fundador — "
+                          "um dos principais limitadores de valor e escala.")
+        elif q7_nivel == 3:
+            linhas.append("Sobre <b>dependência do dono</b>: a operação resiste a ausências curtas, mas decisões-chave "
+                          "ainda se concentram no fundador.")
+        else:
+            linhas.append("Sobre <b>dependência do dono</b>: a empresa demonstra autonomia operacional — base sólida "
+                          "para escala e sucessão.")
+    return linhas
