+function show(i){
+  document.querySelectorAll('.demo-step').forEach(function(s){ s.classList.remove('active'); });
+  var id = (steps[i]==='lead') ? 'step-lead' : 'step-'+steps[i];
+  document.getElementById(id).classList.add('active');
+  document.getElementById('pbar').style.width = (i/(steps.length-1)*100)+'%';
+  window.scrollTo(0,0);
+  // Último passo: trocar "Próxima" por "Ver meu resultado"
+  if(steps[i]!=='lead' && parseInt(steps[i])===lastIdx){
+    var b=document.getElementById('next-'+lastIdx);
+    b.textContent='Ver meu resultado →'; b.classList.remove('btn-verde'); b.classList.add('btn-gold');
+    b.onclick=submitForm;
+  }
+}
+function goQuestions(){
+  var form=document.getElementById('demoForm');
+  // valida campos de lead nativamente
+  var reqs=document.querySelectorAll('#step-lead input[required],#step-lead select[required]');
+  for(var i=0;i<reqs.length;i++){ if(!reqs[i].checkValidity()){ reqs[i].reportValidity(); return; } }
+  cur=1; show(cur);
+}
+function selOp(el){
+  var step=el.closest('.demo-step');
+  step.querySelectorAll('.q-opcao').forEach(function(o){ o.classList.remove('sel'); });
+  el.classList.add('sel');
+  el.querySelector('input').checked=true;
+}
+function nextStep(){
+  var step=document.querySelector('.demo-step.active');
+  var r=step.querySelector('input[type=radio]:checked');
+  if(!r){ alert('Selecione uma opção para continuar.'); return; }
+  if(cur<steps.length-1){ cur++; show(cur); }
+}
+function prevStep(){ if(cur>0){ cur--; show(cur); } }
+function submitForm(){
+  var step=document.querySelector('.demo-step.active');
+  var r=step.querySelector('input[type=radio]:checked');
+  if(!r){ alert('Selecione uma opção para continuar.'); return; }
+  document.getElementById('demoForm').submit();
+}
+show(0);
+</script>
+</body></html>"""
+
